{
  "name": "foxwq-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.11.0",
    "npm": "12.2.0"
  },
  "scripts": {
    "start": "vite --config client/vite.config.ts --host 0.0.0.0",
    "dev": "vite --config client/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:browser && npm run test:integration:harness && npm run test:integration && npm run test:visual",
    "test:unit": "node --import tsx --test client/tests/*.test.ts proxy/tests/*.test.ts score-estimator/tests/*.test.ts",
    "test:client": "node --import tsx --test client/tests/*.test.ts",
    "test:proxy": "node --import tsx --test proxy/tests/*.test.ts",
    "test:browser": "node --import tsx client/tests/browser-check.ts",
    "test:integration": "node --import tsx client/tests/integration/run.ts",
    "test:integration:harness": "node --import tsx --test client/tests/integration/harness.test.ts",
    "test:integration:update": "npm run test:integration -- --update",
    "test:visual": "node --import tsx client/tests/visual/run.ts",
    "test:visual:run": "tsc --noEmit -p client/tsconfig.visual.json && playwright test --config client/playwright.visual.config.ts",
    "proxy:dev": "wrangler dev --config proxy/wrangler.jsonc",
    "proxy:check": "cd proxy && wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "proxy:deploy": "node --import tsx proxy/scripts/deploy-worker.ts",
    "proxy:types": "wrangler types proxy/worker-configuration.d.ts --config proxy/wrangler.jsonc --env-interface ProxyBindings --strict-vars=false",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p client/tsconfig.browser.json && npm run proxy:types && tsc --noEmit -p proxy/tsconfig.json && tsc --noEmit -p proxy/tsconfig.node.json",
    "test:score-estimator": "node --import tsx --test score-estimator/tests/*.test.ts",
    "score-estimator:build": "node score-estimator/scripts/build-docker.ts",
    "score-estimator:check-instructions": "make -C score-estimator check-instructions",
    "test:browser:install": "playwright install --with-deps chromium",
    "score-estimator:build:native": "make -C score-estimator build"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "buffer": "^6.0.3",
    "fflate": "^0.8.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "playwright": "1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "packageManager": "npm@12.2.0"
}
